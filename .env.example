# GROQ_API_KEY: Required for primary fast AI news-processing engine.
GROQ_API_KEY="MY_GROQ_API_KEY"
# GROQ_MODEL: Configurable Groq model ID (defaults to openai/gpt-oss-120b).
GROQ_MODEL="openai/gpt-oss-120b"

# OPENROUTER_API_KEY: Required for NVIDIA Nemotron 3 Super independent verification engine.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"
# OPENROUTER_MODEL: Configurable OpenRouter model slug (defaults to nvidia/nemotron-3-super-120b-a12b).
OPENROUTER_MODEL="nvidia/nemotron-3-super-120b-a12b"

# NEWS_API_KEY: Optional/Required for NewsAPI.org global news collection.
NEWS_API_KEY="MY_NEWS_API_KEY"

# TAVILY_API_KEY: Optional/Required for Tavily evidence discovery and independent domain corroboration.
TAVILY_API_KEY="MY_TAVILY_API_KEY"

# GEMINI_API_KEY: Optional fallback AI provider (quota-exhaustion protected).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
